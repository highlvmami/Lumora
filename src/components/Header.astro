---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { routes, t, type Lang, type RouteKey } from '../lib/i18n';
interface Props { lang: Lang; current?: RouteKey; alternates: Record<Lang, string> }
const { lang, current, alternates } = Astro.props;
const tr = t(lang);
const nav: RouteKey[] = ['projects', 'blog', 'cv', 'about', 'contact'];
---
<header class="site-header sticky top-0 z-40">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href={routes.home[lang]} class="flex items-center gap-2.5">
      <Logo />
      <span class="wordmark">Lumora</span>
    </a>
    <nav class="ml-auto hidden items-stretch self-stretch sm:flex" aria-label={tr('nav.menu')}>
      {nav.map((key) => (
        <a href={routes[key][lang]} aria-current={current === key ? 'page' : undefined} class="nav-link">{tr(`nav.${key}` as const)}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-2 sm:ml-2">
      <ThemeToggle lang={lang} />
      <LangSwitch lang={lang} alternates={alternates} label={tr('lang.label')} />
    </div>
    <details class="relative sm:hidden">
      <summary class="iconbtn cursor-pointer list-none" aria-label={tr('nav.menu')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </summary>
      <nav class="absolute right-0 mt-2 w-52 rounded-md border bg-ink-900 p-1.5" style="border-color:var(--line-strong)">
        {nav.map((key) => (
          <a href={routes[key][lang]} class="nav-link block !py-2.5">{tr(`nav.${key}` as const)}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
