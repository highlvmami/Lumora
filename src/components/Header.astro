---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { routes, t, type Lang, type RouteKey } from '../lib/i18n';
interface Props { lang: Lang; current?: RouteKey; alternates: Record<Lang, string> }
const { lang, current, alternates } = Astro.props;
const tr = t(lang);
const nav: RouteKey[] = ['projects', 'blog', 'about', 'contact'];
---
<header class="sticky top-0 z-40 border-b border-white/5 bg-ink-950/70 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href={routes.home[lang]} class="flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-white">
      <Logo />
      Lumora
    </a>
    <nav class="ml-auto hidden items-center gap-1 sm:flex" aria-label={tr('nav.menu')}>
      {nav.map((key) => (
        <a
          href={routes[key][lang]}
          aria-current={current === key ? 'page' : undefined}
          class:list={[
            'rounded-full px-3 py-1.5 text-sm transition',
            current === key ? 'bg-white/10 text-white' : 'text-white/65 hover:text-white',
          ]}
        >{tr(`nav.${key}` as const)}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-2 sm:ml-2">
      <ThemeToggle lang={lang} />
      <LangSwitch lang={lang} alternates={alternates} label={tr('lang.label')} />
    </div>
    <details class="relative sm:hidden">
      <summary class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full border border-white/10 text-white/80" aria-label={tr('nav.menu')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </summary>
      <nav class="absolute right-0 mt-2 w-48 rounded-2xl border border-white/10 bg-ink-900 p-2 shadow-2xl">
        {nav.map((key) => (
          <a href={routes[key][lang]} class="block rounded-xl px-3 py-2 text-sm text-white/80 hover:bg-white/5">{tr(`nav.${key}` as const)}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
