---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import RepoMeta from './RepoMeta.astro';
import { projectUrl, type Lang } from '../lib/i18n';
import { t } from '../lib/i18n';
interface Props { lang: Lang; project: CollectionEntry<'projects'>; large?: boolean; hidden?: boolean }
const { lang, project, large = false, hidden = false } = Astro.props;
const tr = t(lang);
const p = project.data;
const cover = p.screenshots[0];
---
<div class="relative" data-slug={project.id} hidden={hidden}>
<a
  href={projectUrl(lang, project.id)}
  class="card group flex h-full flex-col overflow-hidden"
  style={`--accent:${p.accent}`}
  data-category={p.category[lang]}
>
  <div class:list={['relative overflow-hidden border-b-[1.5px]', large ? 'aspect-[16/9]' : 'aspect-[16/8]']} style="border-color:var(--line-strong)">
    {cover ? (
      <img src={cover.src} alt={cover.alt[lang]} loading="lazy" decoding="async" class:list={['h-full w-full', cover.portrait ? 'bg-ink-800 object-contain' : 'object-cover object-top']} />
    ) : (
      <div class="initial-block h-full w-full text-8xl" aria-hidden="true">{p.name.replace(/^Lumora\s*/i, '').charAt(0).toUpperCase() || 'L'}</div>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-display text-[1.45rem] font-extrabold leading-none tracking-tight" style="font-variation-settings:'wdth' 88">{p.name}</h3>
      <StatusBadge lang={lang} status={p.status} />
    </div>
    <p class="text-[0.95rem] leading-relaxed text-white/70">{p.tagline[lang]}</p>
    <p class="tech-line mt-auto pt-1">{p.tech.slice(0, 4).join(' / ')}</p>
    <div class="border-t pt-3" style="border-color:var(--line)"><RepoMeta lang={lang} repo={p.repo} /></div>
  </div>
</a>
<button
  type="button"
  data-fav-btn
  hidden
  aria-pressed="false"
  aria-label={tr('fav.add')}
  title={tr('fav.add')}
  class="fav-btn absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center text-lg"
>
  <span aria-hidden="true" data-fav-icon>☆</span>
</button>
</div>
