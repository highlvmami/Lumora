---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import RepoMeta from './RepoMeta.astro';
import { projectUrl, type Lang } from '../lib/i18n';
import { t } from '../lib/i18n';
interface Props { lang: Lang; project: CollectionEntry<'projects'>; large?: boolean; hidden?: boolean }
const { lang, project, large = false, hidden = false } = Astro.props;
const tr = t(lang);
const p = project.data;
const cover = p.screenshots[0];
---
<div class="relative" data-slug={project.id} hidden={hidden}>
<a
  href={projectUrl(lang, project.id)}
  class="card group flex h-full flex-col overflow-hidden"
  data-category={p.category[lang]}
>
  <div class="card-bar">
    <span class="card-path">~/lumora/<b>{project.id}</b></span>
    <StatusBadge lang={lang} status={p.status} />
  </div>
  <div class:list={['relative overflow-hidden border-b', large ? 'aspect-[16/9]' : 'aspect-[16/8]']} style="border-color:var(--line-strong)">
    {cover ? (
      <img src={cover.src} alt={cover.alt[lang]} loading="lazy" decoding="async" class:list={['h-full w-full transition duration-500 group-hover:scale-[1.03]', cover.portrait ? 'bg-ink-800 object-contain' : 'object-cover object-top']} />
    ) : (
      <div class="initial-block h-full w-full text-8xl" aria-hidden="true">{p.name.replace(/^Lumora\s*/i, '').charAt(0).toLowerCase() || 'l'}_</div>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <h3 class="text-[1.3rem] font-bold leading-tight tracking-tight">{p.name}</h3>
    <p class="text-[0.95rem] leading-relaxed text-white/70">{p.tagline[lang]}</p>
    <div class="tech-line mt-auto pt-1">
      <span class="k">stack</span><span>:</span><span>[</span>
      {p.tech.slice(0, 4).map((x, i, arr) => <span class="s">"{x}"{i < arr.length - 1 ? ',' : ''}</span>)}
      <span>]</span>
    </div>
    <div class="border-t pt-3" style="border-color:var(--line)"><RepoMeta lang={lang} repo={p.repo} /></div>
  </div>
</a>
<button
  type="button"
  data-fav-btn
  hidden
  aria-pressed="false"
  aria-label={tr('fav.add')}
  title={tr('fav.add')}
  class="fav-btn absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center text-lg"
>
  <span aria-hidden="true" data-fav-icon>☆</span>
</button>
</div>
