---
import { getRepoStats } from '../lib/github';
import { t, formatDate, type Lang } from '../lib/i18n';
interface Props { lang: Lang; repo: string; detailed?: boolean }
const { lang, repo, detailed = false } = Astro.props;
const stats = await getRepoStats(repo);
const tr = t(lang);
---
{stats && (
  <ul class="meta-row flex flex-wrap items-center gap-x-4 gap-y-1">
    <li><span style="color:var(--star)">★</span> {stats.stars}</li>
    <li>{tr('project.updated')} {formatDate(lang, stats.pushedAt)}</li>
    {detailed && stats.release && <li>{tr('project.release')} {stats.release}</li>}
  </ul>
)}
