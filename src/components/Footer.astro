---
import Logo from './Logo.astro';
import { routes, t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
---
<footer class="mt-24 border-t border-white/5">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 text-sm text-white/50 sm:flex-row sm:items-center sm:px-6">
    <div class="flex items-center gap-2 text-white/80">
      <Logo size={22} />
      <span class="font-display font-semibold">Lumora</span>
    </div>
    <p>© {new Date().getFullYear()} Lumora. {tr('footer.rights')}</p>
    <nav class="flex gap-4 sm:ml-auto">
      <a class="hover:text-white" href={routes.projects[lang]}>{tr('nav.projects')}</a>
      <a class="hover:text-white" href={routes.blog[lang]}>{tr('nav.blog')}</a>
      <a class="hover:text-white" href={routes.about[lang]}>{tr('nav.about')}</a>
      <a class="hover:text-white" href={routes.contact[lang]}>{tr('nav.contact')}</a>
      <a class="hover:text-white" href="https://github.com/highlvmami" rel="noopener">GitHub</a>
    </nav>
  </div>
</footer>
