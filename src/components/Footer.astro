---
import Logo from './Logo.astro';
import { routes, t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
---
<footer class="mt-28 border-t-[1.5px]" style="border-color:var(--line-strong)">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-center sm:px-6">
    <div class="flex items-center gap-2.5">
      <Logo size={22} />
      <span class="wordmark text-lg">Lumora</span>
    </div>
    <p class="meta-row">© {new Date().getFullYear()} Lumora. {tr('footer.rights')}</p>
    <nav class="meta-row flex flex-wrap gap-x-5 gap-y-2 sm:ml-auto">
      <a class="hover:text-white" href={routes.projects[lang]}>{tr('nav.projects')}</a>
      <a class="hover:text-white" href={routes.blog[lang]}>{tr('nav.blog')}</a>
      <a class="hover:text-white" href={routes.about[lang]}>{tr('nav.about')}</a>
      <a class="hover:text-white" href={routes.contact[lang]}>{tr('nav.contact')}</a>
      <a class="hover:text-white" href="https://github.com/highlvmami" rel="noopener">GitHub</a>
      <a class="hover:text-white" href={`/api/auth/login?next=${routes.home[lang]}`} data-admin-link data-login-label={tr('admin.login')} data-logout-label={tr('admin.logout')} data-next={routes.home[lang]} data-fav-add={tr('fav.add')} data-fav-remove={tr('fav.remove')} data-fav-error={tr('fav.error')} rel="nofollow">{tr('admin.login')}</a>
    </nav>
  </div>
</footer>

<script>
  // Öne çıkanlar (herkese açık) ve yönetici girişi. Statik site, /api/* ise Cloudflare Pages Functions.
  const link = document.querySelector<HTMLAnchorElement>('[data-admin-link]');
  const section = document.querySelector<HTMLElement>('[data-fav-section]');
  const grid = section?.querySelector<HTMLElement>('[data-fav-grid]') ?? null;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-slug]')];
  const hasFlag = document.cookie.split('; ').some((c) => c === 'lumora_admin=1');

  let favs: string[] = [];
  let admin = false;

  function render() {
    if (grid && section) {
      // Üstte yalnızca favoriler (kaydedilen sırayla); liste boşsa bölüm hiç görünmez.
      for (const c of grid.querySelectorAll<HTMLElement>('[data-slug]')) {
        const i = favs.indexOf(c.dataset.slug!);
        c.hidden = i < 0;
        c.style.order = String(i < 0 ? 99 : i);
      }
      section.hidden = favs.length === 0;
    }
    for (const c of cards) {
      const on = favs.includes(c.dataset.slug!);
      const btn = c.querySelector<HTMLButtonElement>('[data-fav-btn]');
      if (!btn || !link) continue;
      btn.hidden = !admin;
      btn.setAttribute('aria-pressed', String(on));
      const label = on ? link.dataset.favRemove! : link.dataset.favAdd!;
      btn.setAttribute('aria-label', label);
      btn.title = label;
      btn.dataset.on = String(on);
      btn.querySelector('[data-fav-icon]')!.textContent = on ? '★' : '☆';
    }
  }

  async function loadFavs() {
    try {
      const res = await fetch('/api/favorites');
      const data = await res.json();
      if (Array.isArray(data.slugs)) favs = data.slugs;
    } catch {}
    render();
  }

  async function toggle(slug: string) {
    const next = favs.includes(slug) ? favs.filter((s) => s !== slug) : [...favs, slug];
    const prev = favs;
    favs = next;
    render();
    try {
      const res = await fetch('/api/favorites', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slugs: next }),
      });
      if (!res.ok) throw new Error(String(res.status));
    } catch {
      favs = prev;
      render();
      alert(link?.dataset.favError ?? 'Error');
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('[data-fav-btn]');
    if (!btn) return;
    e.preventDefault();
    const slug = btn.closest<HTMLElement>('[data-slug]')?.dataset.slug;
    if (slug) toggle(slug);
  });

  if (grid) loadFavs();

  if (hasFlag && link) {
    fetch('/api/auth/me')
      .then((r) => r.json())
      .then((me) => {
        if (!me.admin) return;
        admin = true;
        document.documentElement.dataset.admin = '1';
        document.dispatchEvent(new CustomEvent('lumora:admin'));
        link.textContent = `${link.dataset.logoutLabel} (${me.login})`;
        link.href = `/api/auth/logout?next=${link.dataset.next}`;
        if (!grid) return loadFavs();
        render();
      })
      .catch(() => {});
  }
</script>
