---
import type { Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const label = lang === 'tr' ? 'Tema seç' : 'Choose theme';
// Renk örnekleri global.css'teki --bg ve --brand değerleridir.
const themes = [
  { id: 'dark', a: '#1d2021', b: '#fe8019', name: { tr: 'Koyu', en: 'Dark' }, note: { tr: 'Varsayılan terminal', en: 'Default terminal' } },
  { id: 'light', a: '#f3efe2', b: '#af3a03', name: { tr: 'Açık', en: 'Light' }, note: { tr: 'Aydınlık kâğıt', en: 'Bright paper' } },
  { id: 'dim', a: '#2b3339', b: '#e69875', name: { tr: 'Yumuşak koyu', en: 'Soft dark' }, note: { tr: 'Düşük kontrast, göz yormaz', en: 'Low contrast, easy on eyes' } },
  { id: 'sepia', a: '#f1e7d0', b: '#9a4a24', name: { tr: 'Sepya', en: 'Sepia' }, note: { tr: 'Sıcak, okuma dostu', en: 'Warm, reading-friendly' } },
];
---
<div class="relative" data-theme-picker>
  <button
    type="button"
    data-theme-toggle
    aria-label={label}
    title={label}
    aria-haspopup="true"
    aria-expanded="false"
    class="iconbtn"
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.7-.9 1.7-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.8 1.8-1.8H17a4 4 0 0 0 4-4c0-4.4-4-8-9-8z" /><circle cx="7.5" cy="11" r="1" fill="currentColor" /><circle cx="10.5" cy="7.5" r="1" fill="currentColor" /><circle cx="15" cy="7.5" r="1" fill="currentColor" /></svg>
  </button>
  <div class="theme-menu" role="menu" aria-label={label} hidden>
    {themes.map((th) => (
      <button type="button" role="menuitemradio" aria-checked="false" class="theme-opt" data-theme-opt={th.id}>
        <span class="theme-sw" style={`--a:${th.a};--b:${th.b}`} aria-hidden="true"></span>
        <span>{th.name[lang]}<small>{th.note[lang]}</small></span>
      </button>
    ))}
  </div>
</div>
<script>
  const metaColor: Record<string, string> = { dark: '#1d2021', light: '#f3efe2', dim: '#2b3339', sepia: '#f1e7d0' };
  const apply = (id: string) => {
    document.documentElement.dataset.theme = id;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', metaColor[id] ?? metaColor.dark);
    document.querySelectorAll<HTMLElement>('[data-theme-opt]').forEach((o) =>
      o.setAttribute('aria-checked', String(o.dataset.themeOpt === id)),
    );
  };
  apply(document.documentElement.dataset.theme || 'dark');

  document.querySelectorAll<HTMLElement>('[data-theme-picker]').forEach((picker) => {
    const btn = picker.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
    const menu = picker.querySelector<HTMLElement>('.theme-menu')!;
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      if (open) menu.querySelector<HTMLElement>('[aria-checked="true"]')?.focus();
    };
    btn.addEventListener('click', () => setOpen(menu.hidden));
    menu.addEventListener('click', (e) => {
      const opt = (e.target as HTMLElement).closest<HTMLElement>('[data-theme-opt]');
      if (!opt) return;
      const id = opt.dataset.themeOpt!;
      apply(id);
      try { localStorage.setItem('lumora-theme', id); } catch (_) {}
      setOpen(false);
      btn.focus();
    });
    menu.addEventListener('keydown', (e) => {
      const opts = [...menu.querySelectorAll<HTMLElement>('[data-theme-opt]')];
      const i = opts.indexOf(document.activeElement as HTMLElement);
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        opts[(i + (e.key === 'ArrowDown' ? 1 : opts.length - 1)) % opts.length].focus();
      }
    });
    document.addEventListener('click', (e) => { if (!picker.contains(e.target as Node)) setOpen(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); }
    });
  });
</script>
