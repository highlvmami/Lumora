---
import { languages, type Lang } from '../lib/i18n';
interface Props { lang: Lang; alternates: Record<Lang, string>; label: string }
const { lang, alternates, label } = Astro.props;
---
<div class="seg" role="group" aria-label={label}>
  {languages.map((l) => (
    <a href={alternates[l]} hreflang={l} lang={l} data-lang-switch={l} aria-current={l === lang ? 'true' : undefined}>{l}</a>
  ))}
</div>
