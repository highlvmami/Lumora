---
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang; status: 'live' | 'beta' | 'development' }
const { lang, status } = Astro.props;
const styles = {
  live: 'bg-emerald-400/10 text-emerald-300 ring-emerald-400/30',
  beta: 'bg-sky-400/10 text-sky-300 ring-sky-400/30',
  development: 'bg-amber-400/10 text-amber-300 ring-amber-400/30',
};
---
<span class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset', styles[status]]}>
  <span class:list={['h-1.5 w-1.5 rounded-full bg-current', status === 'live' && 'animate-pulse']}></span>
  {t(lang)(`status.${status}`)}
</span>
