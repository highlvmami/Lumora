---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang, type RouteKey } from '../lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  current?: RouteKey;
  alternates: Record<Lang, string>;
  image?: string;
  noindex?: boolean;
}
const { lang, title, description, current, alternates, image = '/og.png', noindex = false } = Astro.props;
const tr = t(lang);
const fullTitle = title ? `${title} · Lumora` : 'Lumora';
const desc = description ?? tr('site.description');
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const isHome = current === 'home';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="tr" href={new URL(alternates.tr, site).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.tr, site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#141311" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lumora" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site).href} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Tema: kayıtlı tercih varsa o, yoksa cihazın teması. Sayfa çizilmeden önce uygulanır (yanıp sönmesin).
      try {
        var saved = localStorage.getItem('lumora-theme');
        var light = saved ? saved === 'light' : window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.theme = light ? 'light' : 'dark';
      } catch (_) {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <script is:inline define:vars={{ isHome, lang, alternates }}>
      // Dil tercihi: değiştiriciye tıklanınca hatırlanır. Ana sayfaya ilk gelişte
      // kayıtlı tercih yoksa tarayıcı diline göre doğru dile yönlendirilir.
      try {
        var saved = localStorage.getItem('lumora-lang');
        if (isHome) {
          var want = saved || ((navigator.language || '').toLowerCase().indexOf('tr') === 0 ? 'tr' : 'en');
          if (want !== lang && alternates[want]) location.replace(alternates[want]);
        }
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('[data-lang-switch]');
          if (a) localStorage.setItem('lumora-lang', a.getAttribute('data-lang-switch'));
        });
      } catch (_) {}
    </script>
  </head>
  <body class="min-h-screen font-sans text-white antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink-900 focus:px-3 focus:py-2">
      {lang === 'tr' ? 'İçeriğe geç' : 'Skip to content'}
    </a>
    <Header lang={lang} current={current} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
