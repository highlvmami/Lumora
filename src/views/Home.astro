---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import { getPosts } from '../lib/posts';
import { routes, postUrl, formatDate, t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const projects = await getProjects();
const latest = (await getPosts(lang)).slice(0, 2);
const live = projects.filter((p) => p.data.status === 'live').length;
const alternates = { tr: routes.home.tr, en: routes.home.en };
const title = tr('hero.title');
const words = title.split(' ');
const parts = [words[0] + ' ', words.slice(1).join(' ')];
let n = 0;
const cmd = 'lumora --hello';
const key = (s: string) => s.replace(/\s+/g, '_');
---
<Base lang={lang} current="home" alternates={alternates}>
  <section class="mx-auto max-w-6xl px-4 pb-12 pt-12 sm:px-6 sm:pt-16">
    <div>
      <p class="prompt mb-6"><b>~/lumora</b> <i>main</i> $ <span class="typed" style={`--n:${cmd.length}`}>{cmd}</span></p>
      <h1 class="hero-title" aria-label={title}>
        <span class="hl" data-n="1" aria-hidden="true">{parts.map((part, pi) => (
          <span class={pi === 1 ? 'hl-accent' : undefined}>{[...part].map((c) => <span class="ch" style={`--i:${n++}`}>{c}</span>)}</span>
        ))}<span class="caret"></span></span>
      </h1>
      <p class="rise mt-8 max-w-3xl text-lg leading-relaxed text-white/75" style="--d:0">{tr('hero.text')}</p>
      <div class="rise mt-8 flex flex-wrap gap-3" style="--d:1">
        <a href={routes.projects[lang]} class="btn">{tr('hero.cta')} →</a>
        <a href="https://github.com/highlvmami" rel="noopener" class="btn-ghost">{tr('hero.github')}</a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="json rise scroll-rise" style="--d:2" role="group">
      <span class="p">{'{'}</span><br />
      <span class="p">&nbsp;&nbsp;</span><span class="k">"{key(tr('home.stats.projects'))}"</span><span class="p">: </span><span class="v" data-count={projects.length}>{projects.length}</span><span class="p">,</span><br />
      <span class="p">&nbsp;&nbsp;</span><span class="k">"{key(tr('home.stats.live'))}"</span><span class="p">: </span><span class="v" data-count={live}>{live}</span><span class="p">,</span><br />
      <span class="p">&nbsp;&nbsp;</span><span class="k">"{key(tr('home.stats.open'))}"</span><span class="p">: </span><span class="s">"100%"</span><br />
      <span class="p">{'}'}</span>
    </div>
  </div>

  <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-labelledby="featured" data-fav-section hidden>
    <div class="section-head">
      <h2 id="featured" class="head2">{tr('home.featured')}</h2>
    </div>
    <p class="comment -mt-3 mb-6">{tr('home.featuredText')}</p>
    <div class="grid gap-6 sm:grid-cols-2" data-fav-grid>
      {projects.map((p) => <ProjectCard lang={lang} project={p} large hidden />)}
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-labelledby="all">
    <div class="section-head">
      <h2 id="all" class="head2">{tr('home.more')}</h2>
      <a href={routes.projects[lang]} class="kicker hidden hover:text-white sm:block" style="color:var(--brand)">{tr('home.all')} →</a>
    </div>
    <p class="comment -mt-3 mb-6">{tr('home.moreText')}</p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-all-grid>
      {projects.map((p) => <div class="scroll-rise h-full" style="display:contents"><ProjectCard lang={lang} project={p} /></div>)}
    </div>
  </section>

  {latest.length > 0 && (
    <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-labelledby="latest">
      <div class="section-head">
        <h2 id="latest" class="head2">{tr('home.latest')}</h2>
        <a href={routes.blog[lang]} class="kicker hover:text-white" style="color:var(--brand)">{tr('home.latestAll')} →</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {latest.map((p) => (
          <a href={postUrl(lang, p.slug)} class="card scroll-rise block p-6">
            <time class="kicker" datetime={p.data.date.toISOString()}>{formatDate(lang, p.data.date.toISOString())}</time>
            <h3 class="mt-2 text-[1.2rem] font-bold leading-snug tracking-tight">{p.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/65">{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  // Sayılar 0'dan yukarı sayar; hareket azaltma açıksa olduğu gibi kalır.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const to = Number(el.dataset.count);
      if (!to) return;
      const start = performance.now() + 900;
      el.textContent = '0';
      const tick = (now: number) => {
        const k = Math.min(1, Math.max(0, (now - start) / 900));
        el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }
</script>
