---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import { getPosts } from '../lib/posts';
import { routes, postUrl, formatDate, t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
const latest = (await getPosts(lang)).slice(0, 2);
const live = projects.filter((p) => p.data.status === 'live').length;
const alternates = { tr: routes.home.tr, en: routes.home.en };
---
<Base lang={lang} current="home" alternates={alternates}>
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-20 sm:px-6 sm:pt-28">
    <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-white/70">
      <span class="h-1.5 w-1.5 rounded-full bg-violet-400 shadow-[0_0_10px_2px_rgba(167,139,250,0.8)]"></span>
      {tr('hero.kicker')}
    </p>
    <h1 class="max-w-3xl font-display text-4xl font-semibold leading-[1.1] tracking-tight sm:text-6xl">
      <span class="text-glow">{tr('hero.title')}</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/65">{tr('hero.text')}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={routes.projects[lang]} class="rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-ink-950 shadow-[0_0_40px_-8px_rgba(167,139,250,0.9)] transition hover:bg-violet-100">{tr('hero.cta')}</a>
      <a href="https://github.com/highlvmami" rel="noopener" class="rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-white/85 transition hover:border-white/40">{tr('hero.github')}</a>
    </div>
    <dl class="mt-14 grid max-w-md grid-cols-3 gap-6">
      <div><dt class="text-xs text-white/50">{tr('home.stats.projects')}</dt><dd class="font-display text-3xl font-semibold">{projects.length}</dd></div>
      <div><dt class="text-xs text-white/50">{tr('home.stats.live')}</dt><dd class="font-display text-3xl font-semibold">{live}</dd></div>
      <div><dt class="text-xs text-white/50">{tr('home.stats.open')}</dt><dd class="font-display text-3xl font-semibold">100%</dd></div>
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6" aria-labelledby="featured">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2 id="featured" class="font-display text-2xl font-semibold">{tr('home.featured')}</h2>
        <p class="mt-1 text-sm text-white/55">{tr('home.featuredText')}</p>
      </div>
      <a href={routes.projects[lang]} class="hidden text-sm text-violet-300 hover:text-violet-200 sm:block">{tr('home.all')} →</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      {featured.map((p) => <ProjectCard lang={lang} project={p} large />)}
    </div>
  </section>

  {others.length > 0 && (
    <section class="mx-auto mt-16 max-w-6xl px-4 sm:px-6" aria-labelledby="more">
      <h2 id="more" class="font-display text-2xl font-semibold">{tr('home.more')}</h2>
      <p class="mb-6 mt-1 text-sm text-white/55">{tr('home.moreText')}</p>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((p) => <ProjectCard lang={lang} project={p} />)}
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="mx-auto mt-16 max-w-6xl px-4 sm:px-6" aria-labelledby="latest">
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2 id="latest" class="font-display text-2xl font-semibold">{tr('home.latest')}</h2>
        <a href={routes.blog[lang]} class="text-sm text-violet-300 hover:text-violet-200">{tr('home.latestAll')} →</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {latest.map((p) => (
          <a href={postUrl(lang, p.slug)} class="card block p-6">
            <time class="text-xs text-white/50" datetime={p.data.date.toISOString()}>{formatDate(lang, p.data.date.toISOString())}</time>
            <h3 class="mt-1 font-display text-lg font-semibold">{p.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/60">{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
