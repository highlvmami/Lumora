---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import { getPosts } from '../lib/posts';
import { routes, postUrl, formatDate, t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const projects = await getProjects();
const latest = (await getPosts(lang)).slice(0, 2);
const live = projects.filter((p) => p.data.status === 'live').length;
const alternates = { tr: routes.home.tr, en: routes.home.en };
---
<Base lang={lang} current="home" alternates={alternates}>
  <section class="mx-auto max-w-6xl px-4 pb-14 pt-14 sm:px-6 sm:pt-20">
    <p class="kicker mb-6 flex items-center gap-3"><span class="inline-block h-[3px] w-10" style="background:var(--brand)"></span>{tr('hero.kicker')}</p>
    <h1 class="display text-[clamp(3.4rem,11.5vw,8.6rem)]">{tr('hero.title')}</h1>
    <div class="mt-10 grid items-end gap-8 md:grid-cols-[1.25fr_1fr]">
      <p class="max-w-xl text-lg leading-relaxed text-white/75">{tr('hero.text')}</p>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={routes.projects[lang]} class="btn">{tr('hero.cta')} →</a>
        <a href="https://github.com/highlvmami" rel="noopener" class="btn-ghost">{tr('hero.github')}</a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <dl class="spec">
      <div><dt class="kicker">{tr('home.stats.projects')}</dt><dd>{projects.length}</dd></div>
      <div><dt class="kicker">{tr('home.stats.live')}</dt><dd>{live}</dd></div>
      <div><dt class="kicker">{tr('home.stats.open')}</dt><dd>100%</dd></div>
    </dl>
  </div>

  <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-labelledby="featured" data-fav-section hidden>
    <div class="section-head">
      <h2 id="featured" class="head2">{tr('home.featured')}</h2>
    </div>
    <p class="-mt-3 mb-6 text-sm text-white/60">{tr('home.featuredText')}</p>
    <div class="grid gap-6 sm:grid-cols-2" data-fav-grid>
      {projects.map((p) => <ProjectCard lang={lang} project={p} large hidden />)}
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-labelledby="all">
    <div class="section-head">
      <h2 id="all" class="head2">{tr('home.more')}</h2>
      <a href={routes.projects[lang]} class="kicker hidden hover:text-white sm:block" style="color:var(--brand)">{tr('home.all')} →</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-all-grid>
      {projects.map((p) => <ProjectCard lang={lang} project={p} />)}
    </div>
  </section>

  {latest.length > 0 && (
    <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-labelledby="latest">
      <div class="section-head">
        <h2 id="latest" class="head2">{tr('home.latest')}</h2>
        <a href={routes.blog[lang]} class="kicker hover:text-white" style="color:var(--brand)">{tr('home.latestAll')} →</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {latest.map((p) => (
          <a href={postUrl(lang, p.slug)} class="card block p-6">
            <time class="kicker" datetime={p.data.date.toISOString()}>{formatDate(lang, p.data.date.toISOString())}</time>
            <h3 class="mt-2 font-display text-[1.35rem] font-bold leading-tight" style="font-variation-settings:'wdth' 90">{p.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/65">{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
