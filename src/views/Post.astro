---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPosts, type Post } from '../lib/posts';
import { postUrl, routes, formatDate, t, type Lang } from '../lib/i18n';
interface Props { lang: Lang; post: Post }
const { lang, post } = Astro.props;
const tr = t(lang);
const { Content } = await render(post);
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const otherExists = (await getPosts(other)).some((p) => p.slug === post.slug);
const alternates = {
  [lang]: postUrl(lang, post.slug),
  [other]: otherExists ? postUrl(other, post.slug) : routes.blog[other],
} as Record<Lang, string>;
---
<Base lang={lang} current="blog" title={post.data.title} description={post.data.description} alternates={alternates}>
  <article class="mx-auto max-w-3xl px-4 pt-12 sm:px-6">
    <a href={routes.blog[lang]} class="kicker hover:text-white">← {tr('blog.back')}</a>
    <time class="kicker mt-10 block" datetime={post.data.date.toISOString()}>{formatDate(lang, post.data.date.toISOString())}</time>
    <h1 class="display text-[clamp(1.9rem,4.8vw,3.1rem)] mt-3">{post.data.title}</h1>
    <p class="mt-6 text-xl leading-relaxed text-white/70">{post.data.description}</p>
    <div class="prose-lumora mt-12"><Content /></div>
  </article>
</Base>
