---
import Base from '../layouts/Base.astro';
import { routes, t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
---
<Base lang={lang} current="about" title={tr('about.title')} alternates={{ tr: routes.about.tr, en: routes.about.en }}>
  <section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6">
    <p class="kicker mb-4">Lumora</p>
    <h1 class="display text-[clamp(2.1rem,5.6vw,3.7rem)]">{tr('about.title')}</h1>
    <div class="mt-8 space-y-5 text-lg leading-relaxed text-white/70">
      <p>{tr('about.p1')}</p>
      <p>{tr('about.p2')}</p>
      <p>{tr('about.p3')}</p>
    </div>
  </section>
</Base>
