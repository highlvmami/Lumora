---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import { routes, t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const projects = await getProjects();
const filters = ['all', 'live', 'development'] as const;
const label = (f: (typeof filters)[number]) => (f === 'all' ? tr('projects.filter.all') : tr(`status.${f}`));
---
<Base lang={lang} current="projects" title={tr('projects.title')} alternates={{ tr: routes.projects.tr, en: routes.projects.en }}>
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
    <p class="kicker mb-4">Lumora</p>
    <h1 class="display text-[clamp(3rem,8vw,5.5rem)]">{tr('projects.title')}</h1>
    <p class="mt-5 max-w-2xl text-lg text-white/70">{tr('projects.text')}</p>
    <div class="mt-8 flex flex-wrap gap-2" role="group" data-filters>
      {filters.map((f, i) => (
        <button
          type="button"
          data-filter={f}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="kicker border-[1.5px] px-3.5 py-2 transition hover:text-white aria-pressed:bg-white aria-pressed:text-ink-950" style="border-color:var(--line-strong)"
        >{label(f)}</button>
      ))}
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-grid>
      {projects.map((p) => (
        <div data-status={p.data.status}><ProjectCard lang={lang} project={p} /></div>
      ))}
    </div>
  </section>
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = document.querySelectorAll<HTMLElement>('[data-grid] > [data-status]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((el) => (el.hidden = f !== 'all' && el.dataset.status !== f));
      }),
    );
  </script>
</Base>
