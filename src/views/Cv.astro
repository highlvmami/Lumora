---
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/projects';
import { cv, skillGroups, skillName } from '../data/cv';
import { routes, projectUrl, t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const projects = await getProjects();

// Her teknoloji kaç projede geçiyor (sürüm ekleri birleştirilmiş adla).
const counts = new Map<string, number>();
for (const p of projects) for (const s of new Set(p.data.tech.map(skillName))) counts.set(s, (counts.get(s) ?? 0) + 1);
const byCount = (a: string, b: string) => counts.get(b)! - counts.get(a)! || a.localeCompare(b);
const grouped = new Set(skillGroups.flatMap((g) => g.items));
const groups = [
  ...skillGroups.map((g) => ({ name: g.name[lang], items: g.items.filter((s) => counts.has(s)).sort(byCount) })),
  { name: tr('cv.other'), items: [...counts.keys()].filter((s) => !grouped.has(s)).sort(byCount) },
].filter((g) => g.items.length > 0);

const done = projects.filter((p) => p.data.status !== 'development');
const next = projects.filter((p) => p.data.status === 'development');
const summary = cv.summary?.[lang] ?? tr('cv.auto').replace('{n}', String(projects.length)).replace('{live}', String(done.length));
const contacts = cv.contacts.filter((c) => c.url);
const show = (url: string) => url.replace(/^(https?:\/\/(www\.)?|mailto:|tel:)/, '').replace(/\/$/, '');
const period = (p: string | { tr: string; en: string }) => (typeof p === 'string' ? p : p[lang]);
---
<Base lang={lang} current="cv" title={tr('cv.title')} alternates={{ tr: routes.cv.tr, en: routes.cv.en }}>
  <section class="cv mx-auto max-w-5xl px-4 pt-14 sm:px-6">
    <div class="cv-bar no-print">
      <p class="prompt"><b>~/cv</b> <i>main</i> $ cat cv.md</p>
      <button type="button" class="btn-ghost" onclick="window.print()">{tr('cv.print')}</button>
    </div>

    <article class="cv-sheet">
      <header class="cv-head">
        <div>
          <h1 class="cv-name">{cv.name}</h1>
          <p class="cv-role">{cv.role[lang]}</p>
        </div>
      </header>

      <p class="cv-summary">{summary}</p>

      <div class="cv-grid">
        <div class="cv-main">
          {cv.experience.length > 0 && (
            <section class="cv-sec">
              <h2 class="cv-h">{tr('cv.experience')}</h2>
              <ul class="cv-list">
                {cv.experience.map((e) => (
                  <li><div class="cv-row"><b>{e.title[lang]}</b><span>{e.period}</span></div><div class="cv-sub">{e.place}</div>{e.text && <p class="cv-text">{e.text[lang]}</p>}</li>
                ))}
              </ul>
            </section>
          )}

          {cv.education.length > 0 && (
            <section class="cv-sec">
              <h2 class="cv-h">{tr('cv.education')}</h2>
              <ul class="cv-list">
                {cv.education.map((e) => (
                  <li><div class="cv-row"><b>{e.title[lang]}</b><span>{period(e.period)}</span></div><div class="cv-sub">{e.place}</div></li>
                ))}
              </ul>
            </section>
          )}

          <section class="cv-sec">
            <h2 class="cv-h">{tr('cv.done')}</h2>
            <ul class="cv-done">
              {done.map((p) => (
                <li>
                  <a href={projectUrl(lang, p.id)}><b>{p.data.name}</b></a>
                  <span>{p.data.tagline[lang]}</span>
                </li>
              ))}
            </ul>
          </section>

          {(next.length > 0 || cv.goals.length > 0) && (
            <section class="cv-sec">
              <h2 class="cv-h">{tr('cv.next')}</h2>
              <ul class="cv-done is-next">
                {next.map((p) => (
                  <li>
                    <a href={projectUrl(lang, p.id)}><b>{p.data.name}</b></a>
                    <span>{p.data.tagline[lang]}</span>
                  </li>
                ))}
                {cv.goals.map((g) => <li><span>{g[lang]}</span></li>)}
              </ul>
            </section>
          )}
        </div>

        <aside class="cv-side">
          <section class="cv-sec">
            <h2 class="cv-h">{tr('cv.contact')}</h2>
            <ul class="cv-contact">
              {contacts.map((c) => (
                <li><span>{c.name}</span><a href={c.url} rel="noopener">{show(c.url)}</a></li>
              ))}
            </ul>
          </section>

          <section class="cv-sec">
            <h2 class="cv-h">{tr('cv.skills')}</h2>
            <dl class="cv-skills">
              {groups.map((g) => (
                <div>
                  <dt>{g.name}</dt>
                  <dd>{g.items.map((s) => <span class="chip">{s}{counts.get(s)! > 1 && <small>×{counts.get(s)}</small>}</span>)}</dd>
                </div>
              ))}
            </dl>
          </section>
        </aside>
      </div>
    </article>
    <p class="comment mt-4 no-print">{tr('cv.text')}</p>
  </section>
</Base>
