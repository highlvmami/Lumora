---
import Base from '../layouts/Base.astro';
import { routes } from '../lib/i18n';
---
<Base lang="tr" title="404" alternates={{ tr: '/404', en: '/404' }}>
  <section class="mx-auto max-w-xl px-4 py-28 text-center sm:px-6">
    <p class="font-display text-7xl font-semibold"><span class="text-glow">404</span></p>
    <h1 class="mt-4 text-xl font-semibold">Sayfa bulunamadı · Page not found</h1>
    <p class="mt-3 text-white/60">Aradığın sayfa taşınmış ya da hiç var olmamış olabilir.<br />The page you're looking for may have moved or never existed.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href={routes.home.tr} class="rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-ink-950">Ana sayfa</a>
      <a href={routes.home.en} class="rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold">Home</a>
    </div>
  </section>
</Base>
